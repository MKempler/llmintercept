{
  "manifest_version": 3,
  "name": "AI Prompt Firewall",
  "version": "1.0.0",
  "description": "Protects your company from AI data leaks - works with ChatGPT, Claude, Gemini, and more",
  "permissions": [
    "storage",
    "webRequest",
    "tabs"
  ],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://chat.openai.com/*",
    "https://api.anthropic.com/*",
    "https://claude.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "https://bard.google.com/*",
    "https://gemini.google.com/*",
    "http://localhost:8000/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://bard.google.com/*",
        "https://gemini.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}

